{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "iniciar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-serchtube.ps1",
    "actualizar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-serchtube.ps1",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "publicar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publicar-release.ps1",
    "prueba-ducking": "tsx scripts/prueba-ducking.ts",
    "prueba-voz": "tsx scripts/prueba-busqueda-voz.ts",
    "prueba-cola": "tsx scripts/prueba-titulos-cola.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fastest-levenshtein": "^1.0.16",
    "firebase": "^12.19.0",
    "franc": "^6.2.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
