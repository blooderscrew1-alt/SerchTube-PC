# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: token de GitHub (solo hace falta si el repositorio es PRIVADO).
# Lo usa "Actualizar SerchTube.bat" para descargar la ultima version sin Git.
# Crealo en https://github.com/settings/tokens con permiso de lectura del repo.
# GITHUB_TOKEN="githu...n"
