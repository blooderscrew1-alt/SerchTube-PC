# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: token de GitHub (imprescindible si el repositorio en GitHub es PRIVADO).
# Lo usa "actualizar.bat" para descargar e instalar la última versión sin Git.
# Créalo en https://github.com/settings/tokens con permiso 'repo'.
# GITHUB_TOKEN="ghp_tu_token_aqui"

# GITHUB_REPO: URL de tu repositorio si es diferente o renombrado (opcional)
# GITHUB_REPO="https://github.com/blooderscrew1-alt/SerchTube-PC.git"
