{
  "manifest_version": 3,
  "name": "YouTube Auto Zoom - Barras negras",
  "version": "1.9.0",
  "description": "Detecta automáticamente las barras negras incrustadas en el video de YouTube y hace zoom o estira la imagen para eliminarlas. Compatible con SerchTube mediante el puente postMessage.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Auto Zoom",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
